generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String  @id
  name        String
  description String
  category    String
  heat        Int
  priceCents  Int
  color       String
  active      Boolean @default(true)
  stock       Int     @default(100)
  jars        Int     @default(1)   // stamps earned per unit (Trio = 3)
  pairs       String[]
  tip         String  @default("")
  reviews     Review[]
  items       OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  stripeSessionId String      @unique
  email           String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  customerId      String?
  freeSalsaUsed   Boolean     @default(false)
  confirmed       Boolean     @default(false)
  status          String      @default("new") // new | ready | out | done | cancelled
  totalCents      Int         @default(0)
  fulfillment     String      @default("pickup") // pickup | delivery
  deliveryAddress String?
  pickupSlot      String?    // "Fri, Oct 16 · 4–6 pm"
  slotDay         String?    // "2026-10-16", for the daily cap
  jarCount        Int        @default(0)
  phone           String?
  partnerCode     String?     // reseller / partner that referred the sale (e.g. BLADE)
  commissionCents Int         @default(0)
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id         String  @id @default(cuid())
  order      Order   @relation(fields: [orderId], references: [id])
  orderId    String
  product    Product @relation(fields: [productId], references: [id])
  productId  String
  quantity   Int
  priceCents Int
}

// Backyard Club profile. Guests can check out without one; signing up later claims past orders by email.
model Customer {
  id         String   @id @default(cuid())
  email      String   @unique
  passwordHash String?
  name       String
  phone      String?
  offers     Boolean  @default(true)  // opted in to offers / new drops
  jars       Int      @default(0)     // lifetime paid jars
  freeUsed   Int      @default(0)     // free salsas redeemed (1 per 10 jars)
  merchUsed  Int      @default(0)     // merch rewards redeemed (1 per 20 jars)
  bonusFree  Int      @default(0)     // extra free salsas (birthday)
  birthMonth Int?                     // 0-11
  bdayYear   Int?                     // last year the birthday reward was given
  referralCode String  @unique @default(cuid())
  referredBy String?
  createdAt  DateTime @default(now())
  orders     Order[]
}

model Review {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  customerId String
  name       String
  stars      Int
  text       String
  createdAt  DateTime @default(now())
}

model Settings {
  id    Int      @id @default(1)
  days  Int[]    @default([4, 5, 6, 0])          // 0=Sun … 6=Sat
  slots String[] @default(["10 am–12 pm", "4–6 pm"])
  cap   Int      @default(40)                    // max jars per day
  daySlots Json  @default("{}")                  // per weekday time windows, e.g. {"5":["4–7 pm"]}; falls back to slots
}

// One-time email login codes (stored hashed, expire in 10 minutes).
model LoginCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// Resellers (e.g. Blade & Barber). Customers arriving via /r/CODE (QR) are attributed to the partner for 30 days.
model Partner {
  id              String  @id @default(cuid())
  code            String  @unique // uppercase, e.g. BLADE
  name            String
  commissionCents Int     @default(100) // paid per jar sold
  active          Boolean @default(true)
}

// Money out (ingredients, jars, labels, commissions paid...). Money in comes from paid orders.
model Expense {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  description String
  category    String   @default("Other")
  amountCents Int
  createdAt   DateTime @default(now())
}

// One-time password reset links (token stored hashed, valid 1 hour).
model PasswordReset {
  id         String   @id @default(cuid())
  customerId String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([customerId])
}
